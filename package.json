{
  "name": "sjensens",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/check-framework-policy.mjs",
    "build": "node scripts/build-site.mjs",
    "test:browser": "playwright test",
    "release:checks": "node scripts/check-csp.mjs && node --test tests/release-policy.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "deploy": "gh workflow run browser-checks.yml --ref main --repo kaj-jensen/sjensens"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "wrangler": "4.164.0"
  }
}
